        "#__Task 1__: Learn a Multilayer Perceptron (MLP) for this 10-class classification task"
      ],
      "metadata": {
        "id": "TAoiHHuzW42K"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "In this notebook, I am training a multilayer perceptron (MLP) to classify images from the CIFAR-10 dataset. The dataset contains 10 different classes of images. I will train the model, measure its accuracy, and compare the training and testing results to see how well the network learns."
      ],
      "metadata": {
        "id": "tfeeKuMhuVVu"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "# CS167 - Notebook #5 Part 1\n",
        "# Seth Anderson\n",
        "# MLP Image Classification using CIFAR-10\n",
        "\n",
        "# Step 1: Import libraries\n",
        "#---------------------------------------\n",
        "import torch\n",
        "from torch import nn\n",
        "from torch.utils.data import DataLoader\n",
        "from torchvision import datasets\n",
        "from torchvision.transforms import ToTensor\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import time\n",
        "\n",
        "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "print(f\"Using {device} device\")\n",
        "\n",
        "\n",
        "# Step 2: Load CIFAR-10 dataset\n",
        "#---------------------------------------\n",
        "training_data = datasets.CIFAR10(\n",
        "    root=\"./datasets\",\n",
        "    train=True,\n",
        "    download=True,\n",
        "    transform=ToTensor()\n",
        ")\n",
        "\n",
        "test_data = datasets.CIFAR10(\n",
        "    root=\"./datasets\",\n",
        "    train=False,\n",
        "    download=True,\n",
        "    transform=ToTensor()\n",
        ")\n",
        "\n",
        "\n",
        "# Step 3: Create MLP with 3 hidden layers\n",
        "#---------------------------------------\n",
        "class SimpleMLPv4(nn.Module):\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "\n",
        "        self.layers = nn.Sequential(\n",
        "            nn.Flatten(),\n",
        "            nn.Linear(3072, 512),\n",
        "            nn.ReLU(),\n",
        "            nn.Linear(512, 256),\n",
        "            nn.ReLU(),\n",
        "            nn.Linear(256, 128),\n",
        "            nn.ReLU(),\n",
        "            nn.Linear(128, 10)\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "        return self.layers(x)\n",
        "\n",
        "\n",
        "# Step 4: Training and testing functions\n",
        "#---------------------------------------\n",
        "def train_loop(dataloader, model, loss_fn, optimizer):\n",
        "    size = len(dataloader.dataset)\n",
        "    model.train()\n",
        "\n",
        "    train_loss = 0\n",
        "    correct = 0\n",
        "\n",
        "    for batch, (X, y) in enumerate(dataloader):\n",
        "        X = X.to(device)\n",
        "        y = y.to(device)\n",
        "\n",
        "        pred = model(X)\n",
        "        loss = loss_fn(pred, y)\n",
        "\n",
        "        loss.backward()\n",
        "        optimizer.step()\n",
        "        optimizer.zero_grad()\n",
        "\n",
        "        train_loss += loss.item()\n",
        "        correct += (pred.argmax(1) == y).sum().item()\n",
        "\n",
        "        if batch % 100 == 0:\n",
        "            current = (batch + 1) * len(X)\n",
        "            print(f\"loss: {loss.item():>7f} [{current:>5d}/{size:>5d}]\")\n",
        "\n",
        "    train_accuracy = 100 * correct / size\n",
        "\n",
        "    return train_loss / len(dataloader), train_accuracy\n",
        "\n",
        "\n",
        "def test_loop(dataloader, model, loss_fn):\n",
        "    model.eval()\n",
        "\n",
        "    size = len(dataloader.dataset)\n",
        "    test_loss = 0\n",
        "    correct = 0\n",
        "\n",
        "    with torch.no_grad():\n",
        "        for X, y in dataloader:\n",
        "            X = X.to(device)\n",
        "            y = y.to(device)\n",
        "\n",
        "            pred = model(X)\n",
        "\n",
        "            test_loss += loss_fn(pred, y).item()\n",
        "            correct += (pred.argmax(1) == y).sum().item()\n",
        "\n",
        "    test_loss /= len(dataloader)\n",
        "    test_accuracy = 100 * correct / size\n",
        "\n",
        "    print(f\"Test Accuracy: {test_accuracy:.2f}%\")\n",
        "    print(f\"Test Loss: {test_loss:.4f}\")\n",
        "\n",
        "    return test_loss, test_accuracy\n",
        "\n",
        "\n",
        "# Step 5: Train the MLP\n",
        "#---------------------------------------\n",
        "batch_size = 64\n",
        "\n",
        "train_dataloader = DataLoader(\n",
        "    training_data,\n",
        "    batch_size=batch_size,\n",
        "    shuffle=True\n",
        ")\n",
        "\n",
        "test_dataloader = DataLoader(\n",
        "    test_data,\n",
        "    batch_size=batch_size\n",
        ")\n",
        "\n",
        "model = SimpleMLPv4().to(device)\n",
        "\n",
        "loss_fn = nn.CrossEntropyLoss()\n",
        "optimizer = torch.optim.Adam(model.parameters(), lr=0.001)\n",
        "\n",
        "epochs = 40\n",
        "\n",
        "train_losses = []\n",
        "test_losses = []\n",
        "train_accuracies = []\n",
        "test_accuracies = []\n",
        "\n",
        "start_time = time.time()\n",
        "\n",
        "for epoch in range(epochs):\n",
        "    print(f\"\\nEpoch {epoch + 1}/{epochs}\")\n",
        "    print(\"--------------------------\")\n",
        "\n",
        "    train_loss, train_accuracy = train_loop(\n",
        "        train_dataloader,\n",
        "        model,\n",
        "        loss_fn,\n",
        "        optimizer\n",
        "    )\n",
        "\n",
        "    test_loss, test_accuracy = test_loop(\n",
        "        test_dataloader,\n",
        "        model,\n",
        "        loss_fn\n",
        "    )\n",
        "\n",
        "    train_losses.append(train_loss)\n",
        "    test_losses.append(test_loss)\n",
        "\n",
        "    train_accuracies.append(train_accuracy)\n",
        "    test_accuracies.append(test_accuracy)\n",
        "\n",
        "training_time = (time.time() - start_time) / 60\n",
        "\n",
        "print(\"\\nTraining Complete!\")\n",
        "print(f\"Training Time: {training_time:.2f} minutes\")\n",
        "\n",
        "\n",
        "# Step 6: Graph the results\n",
        "#---------------------------------------\n",
        "plt.figure(figsize=(8, 5))\n",
        "\n",
        "plt.plot(train_losses, label=\"Training Loss\")\n",
        "plt.plot(test_losses, label=\"Testing Loss\")\n",
        "\n",
        "plt.xlabel(\"Epoch\")\n",
        "plt.ylabel(\"Loss\")\n",
        "plt.title(\"MLP Training vs Testing Loss\")\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "\n",
        "plt.plot(train_accuracies, label=\"Training Accuracy\")\n",
        "plt.plot(test_accuracies, label=\"Testing Accuracy\")\n",
        "\n",
        "plt.xlabel(\"Epoch\")\n",
        "plt.ylabel(\"Accuracy (%)\")\n",
        "plt.title(\"MLP Training vs Testing Accuracy\")\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# Results:\n",
        "best_epoch = np.argmax(test_accuracies) + 1\n",
        "best_accuracy = max(test_accuracies)\n",
        "\n",
        "print(\"\\nMLP Results\")\n",
        "print(\"--------------------------\")\n",
        "print(\"Total Epochs:\", epochs)\n",
        "print(\"Best Epoch:\", best_epoch)\n",
        "print(f\"Best Test Accuracy: {best_accuracy:.2f}%\")\n",
        "print(f\"Final Test Accuracy: {test_accuracies[-1]:.2f}%\")\n",
        "print(f\"Training Time: {training_time:.2f} minutes\")\n",
        "\n",
        "\n"
      ],
